{
  "schema_version": 1,
  "project": "astra-luna-native",
  "version": "0.4.0",
  "release": "python-source",
  "status": "SOURCE_PUBLISHED",
  "license": "Apache-2.0",
  "entrypoint": "astra-luna.py",
  "archive_format": "zip",
  "archive_root_pattern": "astra-luna-native-{version}-{target}",
  "output_directory": "dist/{version}-python",
  "source_equals_runtime": true,
  "checksums": {
    "package_file": "SHA256SUMS",
    "package_coverage": "every regular payload file except SHA256SUMS itself",
    "external_file": "dist/0.4.0-python/SHA256SUMS",
    "external_coverage": "every archive produced in this invocation"
  },
  "public_files": [
    "README.md",
    "README.zh-CN.md",
    "docs/images/README.md",
    "docs/images/workflow-en.svg",
    "docs/images/workflow-zh.svg",
    "docs/images/cli-check.png",
    "docs/images/cli-check.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/PUBLIC_GUIDE.md",
    "docs/VALIDATION.md",
    "docs/UPSTREAM.md",
    "LICENSE",
    "NOTICE",
    "VERSION",
    "release-manifest.json"
  ],
  "source": {
    "required_files": [
      ".gitignore",
      ".github/workflows/native.yml",
      "README.md",
      "README.zh-CN.md",
      "docs/images/README.md",
      "docs/images/workflow-en.svg",
      "docs/images/workflow-zh.svg",
      "docs/images/cli-check.png",
      "docs/images/cli-check.json",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "CHANGELOG.md",
      "LICENSE",
      "NOTICE",
      "VERSION",
      "release-manifest.json",
      "docs/PUBLIC_GUIDE.md",
      "docs/VALIDATION.md",
      "docs/UPSTREAM.md",
      "astra-luna.py",
      "scripts/release_python.py"
    ],
    "required_globs": [
      "astra_luna/**/*.py",
      "astra_luna/**/*.md",
      "tests_python/**/*.py"
    ]
  },
  "runtime": {
    "same_as": "source",
    "python": "3.11+ standard library",
    "entrypoint": "astra-luna.py"
  },
  "excluded_paths": [
    ".orchestrator-dev/",
    ".reference/",
    ".astra-luna/",
    ".git/",
    "AGENTS.md",
    "CODEX_START_PROMPT.md",
    "bin/",
    "dist/",
    "cmd/",
    "internal/",
    "templates/",
    "tests/",
    "astra-luna",
    "SHA256SUMS",
    "scripts/build_release.py",
    "scripts/check_cancel.py",
    "scripts/doctor.py",
    "scripts/install_native.py",
    "scripts/native.py",
    "scripts/native_smoke.py",
    "scripts/prepare_smoke.py",
    "scripts/probe_hooks.py",
    "scripts/test_release.py",
    "scripts/verify_native_events.py",
    "scripts/verify_native_runtime.py",
    "scripts/__pycache__/",
    "cmd/luna-selector/",
    "cmd/orchestrator/",
    "internal/orchestrator/",
    "internal/install/",
    "internal/configmerge/toml_edit.py"
  ],
  "verification": {
    "source_tests": "python3 -m unittest discover -s tests_python -p 'test_*.py' -v",
    "package_build": "python3 scripts/release_python.py --output-dir dist/0.4.0-python",
    "doctor": "python3 astra-luna.py doctor",
    "live": "python3 astra-luna.py verify --live --project PATH --output PATH",
    "live_timeout_seconds": 600,
    "live_children": 2,
    "live_transport": "official transient stdio app-server test channel",
    "live_uses_model_quota": true,
    "remote_ci": "https://github.com/aweiht/astra-luna-native/actions/workflows/native.yml",
    "live_result": "saved real public lifecycle replay and unchanged artifacts independently revalidated after verifier correction; original failure retained"
  },
  "support": {
    "python": "3.11+ standard library; no pip, Go, or compiled binary",
    "macos": "macOS arm64 / Python 3.14.6: local lifecycle and real task artifacts verified",
    "linux": "Ubuntu 24.04 / Python 3.11 and 3.13: offline source, isolated lifecycle and ZIP checks passed; real model tasks not tested",
    "windows": "Windows Server 2022 / Python 3.11 and 3.13: offline source, isolated lifecycle and ZIP checks passed; real model tasks not tested"
  }
}
